# ── Server ──
PORT=4000
NODE_ENV=development

# ── Database (matches docker-compose.yml) ──
DATABASE_URL="postgresql://travel:travel@localhost:5432/travel?schema=public"

# ── Auth ──
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Storage adapter: local | r2 | s3 ──
STORAGE_PROVIDER=local
# Local storage (dev): files saved to ./uploads, served at PUBLIC_BASE_URL/uploads
PUBLIC_BASE_URL="http://localhost:4000"
LOCAL_UPLOAD_DIR="uploads"

# ── R2 / S3 (fill in only when you switch STORAGE_PROVIDER) ──
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# ── Places search (OpenStreetMap Nominatim — free, no key) ──
NOMINATIM_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="TravelX/0.1 (dev)"
